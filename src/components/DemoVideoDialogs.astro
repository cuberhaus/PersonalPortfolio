---
import { getDemo } from '../i18n/demo';
import { getLangFromUrl, useTranslations } from '../i18n/utils';
import { listDemoVideos } from '../lib/demo-videos';
import VideoCaption from './VideoCaption.astro';
import VideoStage from './VideoStage.astro';

/**
 * One modal per video, opened from the "Watch video" button on a project card (see
 * `data-video-open` in Demos.astro). A native <dialog> gives the focus trap,
 * Escape to close and focus return to the button for free. Closed dialogs are not
 * rendered by the browser, and the player is preload="none", so nothing is
 * downloaded until a visitor opens one.
 */
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const base = import.meta.env.BASE_URL === '/' ? '' : import.meta.env.BASE_URL;
const localePrefix = lang === 'en' ? '' : `/${lang}`;

const items = listDemoVideos(lang).map((video) => ({
  video,
  demo: getDemo(video.demo, lang),
  demoHref: `${base}${localePrefix}/demos/${video.demo}/`,
}));
---

{
  items.map(({ video, demo, demoHref }) => (
    <dialog
      class="video-dialog"
      id={`video-dialog-${video.demo}`}
      aria-labelledby={`video-dialog-title-${video.demo}`}
      data-video-dialog
    >
      <div class="video-dialog-panel">
        <div class="video-dialog-bar">
          <h3 class="video-dialog-title" id={`video-dialog-title-${video.demo}`}>
            {demo.title}
          </h3>
          <button
            type="button"
            class="video-dialog-close"
            data-video-close
            aria-label={t('videos.close')}
          >
            <svg
              width="20"
              height="20"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M18 6 6 18M6 6l12 12" />
            </svg>
          </button>
        </div>

        <VideoStage
          video={video}
          title={demo.title}
          lang={lang}
          describedBy={`video-dialog-description-${video.demo}`}
        />
        <VideoCaption
          video={video}
          lang={lang}
          descriptionId={`video-dialog-description-${video.demo}`}
        />

        <a class="video-dialog-link" href={demoHref} data-astro-reload>
          {t('videos.openDemo')}
        </a>
      </div>
    </dialog>
  ))
}

<style>
  .video-dialog {
    /* The global reset zeroes margins, which would pin a modal dialog to the top-left. */
    margin: auto;
    width: min(56rem, calc(100vw - 2rem));
    max-height: calc(100dvh - 2rem);
    padding: 0;
    border: var(--border-width) var(--border-style) var(--border-color);
    border-radius: var(--radius-lg);
    background: var(--bg-card);
    color: var(--text-primary);
    box-shadow: var(--shadow-card);
    overflow: auto;
    /* A long dialog on a short screen scrolls itself; it must not hand the scroll on to the page. */
    overscroll-behavior: contain;
  }

  .video-dialog::backdrop {
    background: color-mix(in srgb, var(--bg-primary) 82%, transparent);
  }

  /* The page behind an open dialog stays where it was. The gutter keeps the layout from
     shifting by a scrollbar's width when the scrollbar goes. */
  :global(html:has(dialog[data-video-dialog][open])) {
    overflow: hidden;
    scrollbar-gutter: stable;
  }

  /*
   * Opening and closing. A native <dialog> flips between display:none and the top layer, so
   * `display` and `overlay` transition as discrete values: that keeps a closing dialog on
   * screen long enough to fade, which is the only way it gets an exit at all. Enter is
   * 180ms and exit 120ms (the visitor is waiting to get back to the page), and the panel
   * settles the way the theme picker does, a short drop and a 0.97 scale, from the centre
   * because a modal is not anchored to its trigger. Reduced motion keeps the fade and
   * drops the movement.
   */
  .video-dialog {
    --dialog-time: 120ms;
    opacity: 1;
    transition-property: opacity, overlay, display;
    transition-duration: var(--dialog-time);
    transition-timing-function: var(--ease-out);
    transition-behavior: allow-discrete;
  }

  .video-dialog::backdrop {
    opacity: 1;
    transition-property: opacity, overlay, display;
    transition-duration: 120ms;
    transition-timing-function: var(--ease-out);
    transition-behavior: allow-discrete;
  }

  .video-dialog[open] {
    --dialog-time: 180ms;
  }

  .video-dialog[open]::backdrop {
    transition-duration: 150ms;
  }

  .video-dialog:not([open]),
  .video-dialog:not([open])::backdrop {
    opacity: 0;
  }

  @starting-style {
    .video-dialog[open],
    .video-dialog[open]::backdrop {
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .video-dialog {
      transition-property: opacity, translate, scale, overlay, display;
    }

    .video-dialog:not([open]) {
      translate: 0 -8px;
      scale: 0.97;
    }

    @starting-style {
      .video-dialog[open] {
        translate: 0 -8px;
        scale: 0.97;
      }
    }
  }

  /* Opened from the keyboard (Enter on the card's link): no entrance and no exit, the same
     rule the theme picker follows for Ctrl+K. */
  .video-dialog[data-instant],
  .video-dialog[data-instant]::backdrop {
    transition: none;
  }

  /* A click that lands on the dialog itself, not on this panel, hit the backdrop. */
  .video-dialog-panel {
    display: grid;
    gap: 1.1rem;
    padding: clamp(1rem, 2.5vw, 1.75rem);
  }

  .video-dialog-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .video-dialog-title {
    font-family: var(--font-display);
    font-size: clamp(1.15rem, 2.2vw, 1.5rem);
    line-height: 1.25;
  }

  .video-dialog-close {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    width: 2.75rem;
    height: 2.75rem;
    border: 1px solid var(--border-color);
    border-radius: var(--radius-sm);
    background: var(--bg-secondary);
    color: var(--text-secondary);
    cursor: pointer;
    transition:
      border-color var(--transition-fast),
      color var(--transition-fast),
      scale var(--transition-press);
  }

  .video-dialog-close:hover {
    border-color: var(--text-secondary);
    color: var(--text-primary);
  }

  .video-dialog-close:focus-visible,
  .video-dialog-link:focus-visible {
    outline: 2px solid var(--accent-start);
    outline-offset: 2px;
  }

  .video-dialog-link {
    justify-self: start;
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    padding: 0.6rem 1.2rem;
    border-radius: var(--radius-sm);
    background: var(--demo-action-bg);
    color: var(--demo-action-color);
    font-size: 0.9rem;
    font-weight: 600;
    text-decoration: none;
    transition:
      background var(--transition-fast),
      color var(--transition-fast),
      box-shadow var(--transition-fast),
      scale var(--transition-press);
  }

  /* Same swap as the card's Watch button: this is the action the card leads to, so it answers
     the pointer the same way (and carries a ring, since in some palettes the action fill and
     the text colour are too close for the swap alone to read). */
  .video-dialog-link:hover,
  .video-dialog-link:focus-visible {
    background: var(--text-primary);
    color: var(--bg-primary);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--accent-start) 45%, transparent);
  }

  /* A link acting as a button: acknowledge the press like the global `button` rule does. */
  .video-dialog-link:active {
    scale: 0.97;
  }

  /* On a landscape phone the dialog is shorter than the player is wide, so the player would
     run off the bottom with its controls out of reach. Cap it to the room left under the
     title bar (about 8.5rem with the panel padding); everywhere else this is simply 100%. */
  .video-dialog :global(.video-stage) {
    justify-self: start;
    width: min(100%, calc((100dvh - 8.5rem) * 16 / 9));
  }
</style>

<script>
  function init() {
    document.querySelectorAll<HTMLDialogElement>('dialog[data-video-dialog]').forEach((dialog) => {
      if (dialog.dataset.dialogReady) return;
      dialog.dataset.dialogReady = 'true';

      dialog
        .querySelector<HTMLElement>('[data-video-close]')
        ?.addEventListener('click', () => dialog.close());
      dialog.addEventListener('click', (event) => {
        if (event.target === dialog) dialog.close();
      });
      // Escape, the close button and the backdrop all end up here.
      dialog.addEventListener('close', () => dialog.querySelector('video')?.pause());
    });

    // Without script, or where <dialog> is missing, the button is a plain link to the project page.
    document.querySelectorAll<HTMLElement>('[data-video-open]').forEach((opener) => {
      if (opener.dataset.openerReady) return;
      opener.dataset.openerReady = 'true';

      opener.addEventListener('click', (event) => {
        const dialog = document.getElementById(`video-dialog-${opener.dataset.videoOpen}`);
        if (!(dialog instanceof HTMLDialogElement) || typeof dialog.showModal !== 'function') {
          return;
        }
        event.preventDefault();
        // A click with no pointer behind it (detail 0) came from the keyboard: skip the
        // entrance and exit, as for any keyboard-initiated action. Set per opening, so the
        // matching close follows suit.
        dialog.toggleAttribute('data-instant', event.detail === 0);
        dialog.showModal();
        // The visitor just asked to watch it: start playing (the click allows it).
        dialog
          .querySelector('video')
          ?.play()
          .catch(() => {
            // Refused: the poster and play button stay, and pressing play works.
          });
      });
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init);
  } else {
    init();
  }
  document.addEventListener('astro:page-load', init);
</script>

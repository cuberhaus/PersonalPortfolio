---
import { Palette } from 'lucide-react';
import { getLangFromUrl, useTranslations } from '../i18n/utils';
import AnalyticsSettingsButton from './AnalyticsSettingsButton.astro';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<footer class="footer">
  <div class="container footer-inner">
    <p class="footer-copy">&copy; {new Date().getFullYear()} Pol Casacuberta</p>
    <button
      class="footer-theme-btn"
      aria-label={t('aria.toggleTheme')}
      title={t('aria.toggleTheme')}
    >
      <Palette size={16} strokeWidth={1.5} aria-hidden="true" />
      <span>{t('theme.customize')}</span>
    </button>
    <AnalyticsSettingsButton variant="footer" />
  </div>
</footer>

<script>
  document.querySelector('.footer-theme-btn')?.addEventListener('click', () => {
    document.dispatchEvent(new CustomEvent('open-theme-modal'));
  });
  document.addEventListener('astro:page-load', () => {
    document.querySelector('.footer-theme-btn')?.addEventListener('click', () => {
      document.dispatchEvent(new CustomEvent('open-theme-modal'));
    });
  });
</script>

<style>
  .footer {
    border-top: 1px solid var(--border-color);
    padding: 2rem 0;
  }

  .footer-inner {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 1rem;
  }

  .footer-copy {
    font-size: 0.85rem;
    color: var(--text-muted);
  }

  .footer-theme-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.35rem 0.65rem;
    border: 1px solid var(--border-color);
    border-radius: var(--radius-sm, 6px);
    background: var(--bg-card, transparent);
    color: var(--text-muted);
    font-size: 0.75rem;
    cursor: pointer;
    min-height: 2rem;
    transition:
      border-color var(--transition-base),
      color var(--transition-base),
      scale var(--transition-press);
  }

  .footer-theme-btn:hover {
    border-color: var(--accent-text);
    color: var(--accent-text);
  }

  @media (max-width: 768px) {
    .footer-theme-btn {
      display: none;
    }
  }
</style>

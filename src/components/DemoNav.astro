---
import { getLangFromUrl, useTranslations } from '../i18n/utils';
import { renderIconSvg } from '../lib/demo-icons';
import { listDemos } from '../i18n/demo';

interface Props {
  currentSlug: string;
}

const { currentSlug } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const allDemos = listDemos(lang);
const base = import.meta.env.BASE_URL === '/' ? '' : import.meta.env.BASE_URL;

function demoHref(slug: string) {
  return lang === 'en' ? `${base}/demos/${slug}/` : `${base}/${lang}/demos/${slug}/`;
}

const currentIdx = allDemos.findIndex((d) => d.slug === currentSlug);
const prevDemo = currentIdx > 0 ? allDemos[currentIdx - 1] : null;
const nextDemo = currentIdx < allDemos.length - 1 ? allDemos[currentIdx + 1] : null;

const excludeSlugs = new Set([currentSlug, prevDemo?.slug, nextDemo?.slug].filter(Boolean));
const candidates = allDemos.filter((d) => !excludeSlugs.has(d.slug));

// Seeded Fisher-Yates shuffle — stable per page, varies between pages
let seed = 0;
for (const ch of currentSlug) seed = ((seed << 5) - seed + ch.charCodeAt(0)) | 0;
seed = (((seed % 2147483646) + 2147483646) % 2147483646) + 1;
function nextRand() {
  seed = (seed * 16807) % 2147483647;
  return (seed - 1) / 2147483646;
}
const shuffled = [...candidates];
for (let i = shuffled.length - 1; i > 0; i--) {
  const j = Math.floor(nextRand() * (i + 1));
  [shuffled[i], shuffled[j]] = [shuffled[j], shuffled[i]];
}
const exploreDemos = shuffled.slice(0, 4);
---

<section class="demo-nav-section">
  <div class="container">
    {/* ── Prev / Next ── */}
    <div class:list={['prevnext-strip', { 'single-item': !prevDemo || !nextDemo }]}>
      {
        prevDemo ? (
          <a href={demoHref(prevDemo.slug)} class="prevnext-card prevnext-prev" data-astro-reload>
            <span class="prevnext-dir">
              <svg
                width="14"
                height="14"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path d="M19 12H5M12 19l-7-7 7-7" />
              </svg>
              {t('demo.previous')}
            </span>
            <span class="prevnext-icon" set:html={renderIconSvg(prevDemo.icon, 24)} />
            <span class="prevnext-title">{prevDemo.title}</span>
            <span class="prevnext-desc">{prevDemo.description}</span>
            <ul class="prevnext-tags">
              {prevDemo.tags.map((tag) => (
                <li>{tag}</li>
              ))}
            </ul>
          </a>
        ) : null
      }
      {
        nextDemo ? (
          <a href={demoHref(nextDemo.slug)} class="prevnext-card prevnext-next" data-astro-reload>
            <span class="prevnext-dir">
              {t('demo.next')}
              <svg
                width="14"
                height="14"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path d="M5 12h14M12 5l7 7-7 7" />
              </svg>
            </span>
            <span class="prevnext-icon" set:html={renderIconSvg(nextDemo.icon, 24)} />
            <span class="prevnext-title">{nextDemo.title}</span>
            <span class="prevnext-desc">{nextDemo.description}</span>
            <ul class="prevnext-tags">
              {nextDemo.tags.map((tag) => (
                <li>{tag}</li>
              ))}
            </ul>
          </a>
        ) : null
      }
    </div>

    {/* ── Explore more ── */}
    {
      exploreDemos.length > 0 && (
        <div class="explore-section">
          <h2 class="explore-heading">{t('demo.moreProjects')}</h2>
          <div class="explore-grid">
            {exploreDemos.map((demo) => (
              <a href={demoHref(demo.slug)} class="explore-card" data-astro-reload>
                <span class="explore-icon" set:html={renderIconSvg(demo.icon, 20)} />
                <div class="explore-info">
                  <span class="explore-title">{demo.title}</span>
                  <ul class="explore-tags">
                    {demo.tags.map((tag) => (
                      <li>{tag}</li>
                    ))}
                  </ul>
                </div>
                <svg
                  class="explore-arrow"
                  width="16"
                  height="16"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <path d="M5 12h14M12 5l7 7-7 7" />
                </svg>
              </a>
            ))}
          </div>
        </div>
      )
    }
  </div>
</section>

<style>
  .demo-nav-section {
    margin-top: 4rem;
    padding: 3rem 0 2rem;
    border-top: 1px solid var(--text-primary);
  }

  /* ── Prev / Next ── */
  .prevnext-strip {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0;
    margin-bottom: 2.5rem;
    border-top: 1px solid var(--border-color);
    border-bottom: 1px solid var(--border-color);
  }

  .prevnext-card {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding: 1.25rem 1.5rem 1.25rem 0;
    background: transparent;
    border: 0;
    border-radius: 0;
    text-decoration: none;
    color: var(--text-primary);
    transition:
      color var(--transition-fast),
      background-color var(--transition-fast);
  }

  .prevnext-card:hover {
    background: color-mix(in srgb, var(--accent-start) 6%, transparent);
  }

  .prevnext-card:focus-visible,
  .explore-card:focus-visible {
    outline: 2px solid var(--accent-text);
    outline-offset: 3px;
  }

  .prevnext-dir {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.75rem;
    font-weight: 650;
    color: var(--accent-text);
  }

  .prevnext-icon {
    color: var(--accent-text);
    display: flex;
    align-items: center;
  }

  .prevnext-title {
    font-size: 1.05rem;
    font-weight: 700;
    line-height: 1.3;
    color: var(--text-primary);
    transition: color var(--transition-fast);
  }

  .prevnext-card:hover .prevnext-title {
    color: var(--accent-text);
  }

  .prevnext-desc {
    font-size: 0.8rem;
    line-height: 1.5;
    color: var(--text-secondary);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .prevnext-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem;
    margin-top: 0.15rem;
  }

  .prevnext-tags li {
    font-size: 0.68rem;
    color: var(--text-muted);
  }

  .prevnext-tags li:not(:last-child)::after,
  .explore-tags li:not(:last-child)::after {
    content: '/';
    margin-left: 0.3rem;
    color: var(--border-color-hover);
  }

  .prevnext-next {
    text-align: right;
    align-items: flex-end;
    padding-right: 0;
    padding-left: 1.5rem;
    border-left: 1px solid var(--border-color);
  }

  .prevnext-next .prevnext-tags {
    justify-content: flex-end;
  }

  .prevnext-strip.single-item .prevnext-card {
    width: 50%;
  }

  .prevnext-strip.single-item .prevnext-next {
    grid-column: 1 / -1;
    justify-self: end;
  }

  /* ── Explore more ── */
  .explore-heading {
    font-size: 1.2rem;
    font-weight: 700;
    margin-bottom: 1rem;
    color: var(--text-primary);
  }

  .explore-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    column-gap: 1.5rem;
  }

  .explore-card {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.9rem 0;
    background: transparent;
    border: 0;
    border-top: 1px solid var(--border-color);
    border-radius: 0;
    text-decoration: none;
    color: var(--text-primary);
    transition:
      color var(--transition-fast),
      background-color var(--transition-fast);
  }

  .explore-card:hover {
    background: color-mix(in srgb, var(--accent-start) 6%, transparent);
  }

  .explore-icon {
    flex-shrink: 0;
    color: var(--accent-text);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .explore-info {
    flex: 1;
    min-width: 0;
  }

  .explore-title {
    display: block;
    font-size: 0.88rem;
    font-weight: 600;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    color: var(--text-primary);
    transition: color var(--transition-fast);
  }

  .explore-card:hover .explore-title {
    color: var(--accent-text);
  }

  .explore-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem;
    margin-top: 0.3rem;
  }

  .explore-tags li {
    font-size: 0.65rem;
    color: var(--text-muted);
  }

  .explore-arrow {
    flex-shrink: 0;
    color: var(--text-muted);
    opacity: 0;
    transform: translateX(-4px);
    transition:
      opacity var(--transition-fast),
      transform var(--transition-fast),
      color var(--transition-fast);
  }

  .explore-card:hover .explore-arrow {
    opacity: 1;
    transform: translateX(0);
    color: var(--accent-text);
  }

  @media (max-width: 768px) {
    .prevnext-strip {
      grid-template-columns: 1fr;
    }

    .prevnext-strip.single-item .prevnext-card {
      width: 100%;
    }

    .prevnext-next {
      text-align: left;
      align-items: flex-start;
      padding-left: 0;
      border-left: 0;
      border-top: 1px solid var(--border-color);
    }

    .prevnext-next .prevnext-tags {
      justify-content: flex-start;
    }

    .explore-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .prevnext-card,
    .explore-card,
    .prevnext-title,
    .explore-title,
    .explore-arrow {
      transition: none;
    }
  }
</style>

---
import { getLangFromUrl, useTranslations } from '../i18n/utils';
import { resolveCvAssets } from '../lib/cv-assets';
import { CV_LANG_BY_LOCALE, getCvAssetPath } from './CvDownloader';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

// The one filled action is the default CV (standard, with portrait): the About
// section keeps the other versions. Same file and cache-bust version as there.
const base = import.meta.env.BASE_URL === '/' ? '' : import.meta.env.BASE_URL;
const { assetBase, assetVersion } = resolveCvAssets(base);
const cv = getCvAssetPath(CV_LANG_BY_LOCALE[lang], 'standard', true, assetVersion, assetBase);
---

<section class="hero" id="hero">
  <div class="hero-bg" aria-hidden="true">
    <div class="hero-gradient"></div>
    <div class="hero-grid"></div>
  </div>

  <div class="hero-content container">
    <p class="hero-greeting">{t('hero.greeting')}</p>
    <h1 class="hero-name">Pol Casacuberta</h1>
    <p class="hero-tagline">
      {t('hero.tagline_1')}{' '}
      <span class="gradient-text">{t('hero.tagline_2')}</span>
    </p>
    <p class="hero-description">
      {t('hero.description')}
    </p>
    <div class="hero-actions">
      <a
        href={cv.href}
        download={cv.filename}
        target="_blank"
        rel="noopener noreferrer"
        class="hero-cta"
      >
        {t('hero.cta')}
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path
            d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4M7 10l5 5 5-5M12 15V3"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"></path>
        </svg>
      </a>
      <a href="#work" class="hero-link">
        {t('hero.secondary')}
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
          <path
            d="M8 3v10M3 8l5 5 5-5"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"
            stroke-linejoin="round"></path>
        </svg>
      </a>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: 85vh;
    display: flex;
    align-items: center;
    overflow: hidden;
  }

  .hero-bg {
    position: absolute;
    inset: 0;
    z-index: 0;
    overflow: hidden;
  }

  .hero-gradient {
    position: absolute;
    top: -30%;
    left: 0;
    width: 100%;
    height: 80%;
    background: radial-gradient(
      ellipse at center,
      color-mix(in srgb, var(--accent-start) 12%, transparent) 0%,
      color-mix(in srgb, var(--accent-end) 6%, transparent) 40%,
      transparent 70%
    );
    transform-origin: center top;
    animation: pulse 8s ease-in-out infinite alternate;
  }

  @keyframes pulse {
    0% {
      opacity: 0.6;
      transform: scaleY(1);
    }
    100% {
      opacity: 1;
      transform: scaleY(1.08);
    }
  }

  .hero-grid {
    position: absolute;
    inset: 0;
    background-image: radial-gradient(
      circle,
      color-mix(in srgb, var(--accent-start) 8%, transparent) 1px,
      transparent 1px
    );
    background-size: 40px 40px;
    mask-image: radial-gradient(ellipse 60% 50% at 50% 40%, black, transparent);
    -webkit-mask-image: radial-gradient(ellipse 60% 50% at 50% 40%, black, transparent);
  }

  .hero-content {
    position: relative;
    z-index: 1;
    /* #hero is a flex row: without this the item grows to its widest word and
       the paragraph is clipped by the section's overflow instead of wrapping. */
    min-width: 0;
    /* Fill the container: a flex item without a width is shrink-wrapped and its
       auto margins centre it, which set the name up to 107px right of the nav
       logo and every section title. */
    width: 100%;
    padding-top: calc(var(--nav-height) + 2rem);
  }

  .hero-greeting {
    font-family: var(--font-mono);
    font-size: 1rem;
    color: var(--accent-text);
    margin-bottom: 1.25rem;
  }

  .hero-name {
    font-size: clamp(3rem, 8vw, 5rem);
    font-weight: 800;
    letter-spacing: -0.03em;
    margin-bottom: 0.75rem;
  }

  .hero-tagline {
    font-size: clamp(1.25rem, 3vw, 1.75rem);
    font-weight: 600;
    color: var(--text-secondary);
    margin-bottom: 1.5rem;
  }

  .hero-description {
    max-width: 540px;
    font-size: 1.05rem;
    color: var(--text-muted);
    margin-bottom: 2.5rem;
    line-height: 1.8;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 1.75rem;
  }

  .hero-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.85rem 2rem;
    font-weight: 600;
    font-size: 0.95rem;
    color: #fff;
    background: var(--accent-gradient);
    border-radius: var(--radius-md);
    transition:
      transform var(--transition-fast),
      box-shadow var(--transition-fast),
      scale var(--transition-press);
  }

  .hero-cta:active {
    scale: 0.97;
  }

  .hero-cta:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 30px var(--glow-color-strong);
  }

  /* The quiet way on: a text link, not a second button. */
  .hero-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 2.75rem;
    font-weight: 600;
    font-size: 0.95rem;
    color: var(--text-primary);
    text-decoration: underline;
    text-decoration-color: var(--accent-text);
    text-decoration-thickness: 1px;
    text-underline-offset: 0.35em;
    transition: color var(--transition-fast);
  }

  .hero-link:hover {
    color: var(--accent-text);
  }

  /* A scroll cue, not ambient decoration: two nudges (4s) and it settles, so
     nothing keeps moving beside the text (WCAG 2.2.2). */
  .hero-link svg {
    animation: scroll-nudge 2s ease-in-out 2;
  }

  @keyframes scroll-nudge {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(3px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-gradient {
      animation: none;
    }

    .hero-link svg {
      animation: none;
    }
  }

  @media (max-height: 700px) {
    .hero-content {
      padding-bottom: 4rem;
    }
  }
</style>

---
import { getLangFromUrl, useTranslations } from '../i18n/utils';
import { renderIconSvg } from '../lib/demo-icons';
import { listDemos } from '../i18n/demo';
import { formatVideoLength, listDemoVideos } from '../lib/demo-videos';
import DemoVideoDialogs from './DemoVideoDialogs.astro';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const demos = listDemos(lang);

const previewModules = import.meta.glob<string>('../../docs/assets/demo-gallery/*.jpg', {
  eager: true,
  import: 'default',
  query: '?url',
});
const previews = Object.fromEntries(
  Object.entries(previewModules).map(([path, url]) => [
    path.split('/').at(-1)?.replace('.jpg', ''),
    url,
  ])
);

const base = import.meta.env.BASE_URL === '/' ? '' : import.meta.env.BASE_URL;

// Projects that have a short video get a "Watch" badge on their card.
const localePrefix = lang === 'en' ? '' : `/${lang}`;
const cardVideos = Object.fromEntries(
  listDemoVideos(lang).map((video) => {
    const title = demos.find((d) => d.slug === video.demo)?.title ?? video.demo;
    const length = formatVideoLength(video.seconds);
    return [
      video.demo,
      {
        length,
        href: `${base}${localePrefix}/demos/${video.demo}/#video`,
        label: t('videos.watchLabel')
          .replace('{title}', title)
          .replace('{length}', t('videos.seconds').replace('{n}', String(video.seconds))),
      },
    ];
  })
);

const { num } = Astro.props;
---

<section
  class="section demos"
  id="projects"
  data-num={num}
  data-filtered-collection
  data-item-label={t('nav.projects')}
  data-mobile-breakpoint="640"
>
  <div class="container">
    <div class="reveal">
      <span class="section-label">{t('projects.label')}</span>
      <h2 class="section-title">{t('projects.title')}</h2>
      <p class="section-subtitle">
        {t('projects.subtitle')}
      </p>
    </div>

    <div class="demo-filters reveal" role="group" aria-label="Filter projects by category">
      <button
        class="demo-filter-btn active"
        data-category="all"
        data-filter-value="all"
        aria-pressed="true"
      >
        {t('demo.allDemos')}
      </button>
      {
        ['ai-ml', 'web', 'algorithms', 'graphics', 'robotics', 'academic'].map((cat) => (
          <button
            class="demo-filter-btn"
            data-category={cat}
            data-filter-value={cat}
            aria-pressed="false"
          >
            {t(`demo.categories.${cat}` as keyof typeof t)}
          </button>
        ))
      }
    </div>
    <div aria-live="polite" class="sr-only" id="demo-filter-announcer"></div>

    <div class="demo-grid reveal-stagger" id="demo-grid">
      {
        demos.map((demo, index) => (
          <article
            class="demo-card"
            data-index={index}
            data-category={demo.category || 'other'}
            data-filter-value={demo.category || 'other'}
          >
            <div class="demo-preview" aria-hidden="true">
              <img
                src={previews[demo.slug]}
                alt=""
                width="1440"
                height="900"
                loading={index < 3 ? 'eager' : 'lazy'}
                decoding="async"
              />
            </div>
            <div class="demo-card-inner">
              <div class="demo-icon" set:html={renderIconSvg(demo.icon, 28)} />

              {/* GitHub link moved to footer */}

              <div class="demo-badge">
                <span>{t('projects.badge')}</span>
                <svg
                  width="14"
                  height="14"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <path d="M5 12h14M12 5l7 7-7 7" />
                </svg>
              </div>

              <h3 class="demo-title">
                <a
                  href={`${base}${lang === 'en' ? '' : `/${lang}`}/demos/${demo.slug}/`}
                  class="full-card-link"
                  data-astro-reload
                >
                  {demo.title}
                </a>
              </h3>
              <p class="demo-desc">{demo.description}</p>

              {cardVideos[demo.slug] && (
                <a
                  class="demo-video-button"
                  href={cardVideos[demo.slug].href}
                  data-video-open={demo.slug}
                  data-astro-reload
                  aria-label={cardVideos[demo.slug].label}
                >
                  <span class="demo-video-play" aria-hidden="true">
                    <svg viewBox="0 0 24 24" width="14" height="14" fill="currentColor">
                      <path d="M8 5.14v13.72a1 1 0 0 0 1.5.86l11-6.86a1 1 0 0 0 0-1.72l-11-6.86A1 1 0 0 0 8 5.14z" />
                    </svg>
                  </span>
                  <span class="demo-video-text">
                    <span class="demo-video-label">{t('videos.watch')}</span>{' '}
                    <span class="demo-video-length">{cardVideos[demo.slug].length}</span>
                  </span>
                </a>
              )}

              <div class="demo-card-footer">
                <ul class="demo-tags">
                  {demo.tags.map((tag) => (
                    <li>{tag}</li>
                  ))}
                </ul>

                {demo.github && (
                  <div style="display: flex; gap: 0.5rem;">
                    {(Array.isArray(demo.github) ? demo.github : [demo.github]).map((link) => (
                      <a
                        href={link}
                        class="demo-github-link"
                        target="_blank"
                        rel="noopener noreferrer"
                        aria-label={t('aria.viewGithub')}
                        title={link}
                      >
                        <svg
                          width="24"
                          height="24"
                          viewBox="0 0 24 24"
                          fill="none"
                          stroke="currentColor"
                          stroke-width="2"
                          stroke-linecap="round"
                          stroke-linejoin="round"
                        >
                          <path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4" />
                          <path d="M9 18c-4.51 2-5-2-7-2" />
                        </svg>
                      </a>
                    ))}
                  </div>
                )}
              </div>
            </div>
          </article>
        ))
      }
    </div>

    {
      demos.length > 6 && (
        <div class="show-more-container reveal">
          <button
            id="show-more-demos"
            class="show-more-btn"
            aria-expanded="false"
            aria-controls="demo-grid"
            data-more-label={t('projects.showMore')}
            data-less-label={t('projects.showLess')}
          >
            {t('projects.showMore')}
          </button>
        </div>
      )
    }
  </div>

  <DemoVideoDialogs />
</section>

<script>
  import { initializeFilteredCollections } from '../lib/filtered-collection';

  function init() {
    initializeFilteredCollections();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init);
  } else {
    init();
  }
  document.addEventListener('astro:page-load', init);
</script>

<style>
  .demo-filters {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-bottom: 2rem;
    justify-content: center;
  }

  .demo-filter-btn {
    background: var(--bg-secondary);
    border: 1px solid var(--border-color);
    color: var(--text-secondary);
    padding: 0.5rem 1.25rem;
    border-radius: 2rem;
    font-size: 0.85rem;
    font-weight: 600;
    cursor: pointer;
    transition:
      background-color var(--transition-fast),
      border-color var(--transition-fast),
      color var(--transition-fast),
      scale var(--transition-press);
    font-family: inherit;
  }

  .demo-filter-btn:hover {
    border-color: var(--accent-text);
    color: var(--text-primary);
  }

  .demo-filter-btn.active {
    background: color-mix(in srgb, var(--accent-start) 15%, transparent);
    border-color: var(--accent-text);
    color: var(--text-primary);
  }

  /* Touch: chips are the primary control here, so give them a full-size target. */
  @media (pointer: coarse) {
    .demo-filter-btn,
    .show-more-btn {
      min-height: 2.75rem;
    }
  }

  .demo-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
  }

  .demo-card {
    position: relative;
    border-radius: var(--radius-lg);
    background: var(--bg-card);
    border: 1px solid var(--border-color);
    transition:
      transform var(--transition-base),
      border-color var(--transition-base),
      box-shadow var(--transition-base);
    overflow: hidden;
    display: flex;
    flex-direction: column;
  }

  .demo-card[hidden] {
    display: none !important;
  }

  .demo-card:hover {
    transform: translateY(-4px);
    border-color: var(--accent-text);
    box-shadow: 0 12px 40px var(--glow-color);
  }

  /*
   * A button, not a caption, and deliberately not on the preview: a play pill over a picture
   * reads as "this picture is the video". It lives with the card's other actions, names what
   * it does, and on hover inverts to the design's primary text/background pair, which the
   * card never does.
   */
  .demo-video-button {
    /* Above the card's full-size link (z-index 1). */
    position: relative;
    z-index: 10;
    align-self: flex-start;
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    max-width: 100%;
    min-height: 2.75rem;
    margin-bottom: 1.25rem;
    padding: 0.3rem 1.1rem 0.3rem 0.4rem;
    /* A pill on rounded designs, a rectangle on the square-cornered ones. */
    border-radius: calc(var(--radius-lg) * 4);
    border: 1px solid color-mix(in srgb, var(--demo-action-color) 40%, transparent);
    background: var(--demo-action-bg);
    color: var(--demo-action-color);
    font-size: 0.9rem;
    font-weight: 700;
    line-height: 1;
    text-decoration: none;
    cursor: pointer;
  }

  .demo-video-play {
    display: grid;
    place-items: center;
    flex-shrink: 0;
    width: 2rem;
    height: 2rem;
    border-radius: 50%;
    background: color-mix(in srgb, currentColor 22%, transparent);
  }

  /* Label and length are one run of text, so in a narrow card column (the 3-up grid of the
     slimmer designs) the length drops under the label instead of being clipped by the pill,
     and the label itself never breaks mid-phrase. */
  .demo-video-text {
    min-width: 0;
    line-height: 1.2;
  }

  .demo-video-label,
  .demo-video-length {
    white-space: nowrap;
  }

  .demo-video-length {
    font-family: var(--font-mono);
    font-weight: 600;
  }

  .demo-video-button:hover,
  .demo-video-button:focus-visible {
    border-color: transparent;
    background: var(--text-primary);
    color: var(--bg-primary);
    /* Some palettes (sepia) make the action fill and the text colour near-identical, so the
       colour swap alone can't be the only sign that this is its own control. */
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--accent-start) 45%, transparent);
  }

  .demo-video-button:focus-visible {
    outline: 2px solid var(--accent-start);
    outline-offset: 2px;
  }

  /* While the pointer is on the button, the card's own "Live demo" label steps aside. */
  .demo-card:has(.demo-video-button:hover) .demo-badge {
    opacity: 0;
    transform: translateX(-8px);
  }

  /* A link acting as a button: acknowledge the press like the global `button` rule does. */
  .demo-video-button:active {
    scale: 0.97;
  }

  @media (prefers-reduced-motion: no-preference) {
    .demo-video-button {
      /* Border and ring are part of the hover swap: left out, they snap while the fill fades. */
      transition:
        transform var(--transition-base),
        background var(--transition-fast),
        color var(--transition-fast),
        border-color var(--transition-fast),
        box-shadow var(--transition-fast),
        scale var(--transition-press);
    }

    .demo-video-button:hover {
      transform: translateY(-2px);
    }
  }

  .demo-preview {
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background: color-mix(in oklab, var(--accent-text) 18%, var(--bg-secondary));
    border-bottom: 1px solid var(--border-color);
    isolation: isolate;
  }

  .demo-preview img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top;
    filter: grayscale(1) contrast(0.92);
    mix-blend-mode: luminosity;
    opacity: 0.72;
    transform: scale(1.01);
    transition:
      filter var(--transition-base),
      opacity var(--transition-base),
      transform var(--transition-slow);
  }

  .demo-card:hover .demo-preview img {
    filter: grayscale(1) contrast(1);
    opacity: 0.88;
    transform: scale(1.035);
  }

  .demo-card-inner {
    padding: 2rem;
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  .demo-icon {
    color: var(--accent-text);
    margin-bottom: 1.25rem;
  }

  .demo-badge {
    position: absolute;
    top: 1.5rem;
    right: 1.5rem;
    display: flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--accent-text);
    background: color-mix(in srgb, var(--bg-primary) 88%, transparent);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-sm);
    padding: 0.25rem 0.5rem;
    backdrop-filter: blur(8px);
    opacity: 0;
    transform: translateX(-8px);
    transition:
      opacity var(--transition-base),
      transform var(--transition-base);
    pointer-events: none;
    z-index: 5;
  }

  .demo-card-footer {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    margin-top: auto;
    gap: 1rem;
  }

  .demo-github-link {
    position: relative;
    z-index: 10;
    color: var(--text-muted);
    transition:
      color var(--transition-fast),
      transform var(--transition-fast),
      scale var(--transition-press);
    padding: 0.25rem;
    border-radius: var(--radius-sm);
    pointer-events: auto;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  /* Invisible hit area: the glyph stays small, the target reaches 44px. */
  .demo-github-link::before {
    content: '';
    position: absolute;
    inset: -0.5rem;
  }

  .demo-github-link:hover {
    color: var(--text-primary);
    transform: scale(1.1);
  }

  .demo-github-link:active {
    scale: 0.9;
  }

  .full-card-link {
    color: inherit;
    text-decoration: none;
  }

  .full-card-link::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
  }

  .demo-card:hover .demo-badge {
    opacity: 1;
    transform: translateX(0);
    pointer-events: none; /* Make sure the badge doesn't block the github link clicks if it somehow overlaps */
  }

  .demo-title {
    font-size: 1.15rem;
    margin-bottom: 0.65rem;
    transition: color var(--transition-fast);
  }

  .demo-card:hover .demo-title {
    color: var(--accent-text);
  }

  .demo-desc {
    font-size: 0.9rem;
    color: var(--text-muted);
    line-height: 1.7;
    flex: 1;
    margin-bottom: 1.25rem;
  }

  .demo-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .demo-tags li {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--text-secondary);
    background: var(--bg-secondary);
    padding: 0.2rem 0.6rem;
    border-radius: var(--radius-sm);
  }

  @media (max-width: 1024px) {
    .demo-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 640px) {
    .demo-grid {
      grid-template-columns: 1fr;
    }
  }

  .show-more-container {
    display: flex;
    justify-content: center;
    margin-top: 3rem;
  }

  .show-more-container[hidden] {
    display: none !important;
  }

  .show-more-btn {
    background: transparent;
    border: 1px solid var(--accent-start);
    color: var(--accent-text);
    padding: 0.75rem 2rem;
    border-radius: 2rem;
    font-size: 0.95rem;
    font-weight: 600;
    cursor: pointer;
    transition:
      background-color var(--transition-fast),
      transform var(--transition-fast),
      scale var(--transition-press);
    font-family: inherit;
  }

  .show-more-btn:hover {
    background: color-mix(in srgb, var(--accent-start) 10%, transparent);
    transform: translateY(-2px);
  }
</style>

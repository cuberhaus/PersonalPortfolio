  .theme-modal-design[data-preview-style='deco'] .theme-modal-design-sample {
    background: linear-gradient(135deg, #e8cf89 0%, #b88d3a 50%, #e8cf89 100%);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    font-weight: 400;
  }

  /* Wabi-sabi tile: cream paper, one thin vertical accent, subtle ink */
  .theme-modal-design[data-preview-style='zen'] .theme-modal-design-preview {
    background:
      linear-gradient(to right,
        color-mix(in oklab, var(--text-primary) 35%, transparent) 0,
        color-mix(in oklab, var(--text-primary) 35%, transparent) 1px,

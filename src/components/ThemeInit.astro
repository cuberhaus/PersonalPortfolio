    text-align: center;
  }

  .theme-modal-footer kbd {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    background: var(--bg-secondary);
    padding: 0.1rem 0.3rem;
    border-radius: 3px;
    border: 1px solid var(--border-color);
  }

  @media (max-width: 480px) {
    .theme-modal-design-grid {
      grid-template-columns: 1fr;
    }
  }

  /* ── Mobile bottom-sheet layout ───────────────────────── */
  @media (max-width: 640px) {
    .theme-modal {
      align-items: flex-end;
    }

    .theme-modal-panel {
      width: 100%;
      max-height: 85vh;
      max-height: 85dvh;
      border-radius: var(--radius-lg) var(--radius-lg) 0 0;
      padding: 1rem 1rem calc(1rem + env(safe-area-inset-bottom, 0px));
      animation: tm-slide-up 220ms var(--ease-drawer);
    }

    @keyframes tm-slide-up {
      from { opacity: 0; transform: translateY(100%); }
      to { opacity: 1; transform: translateY(0); }
    }

    .theme-modal-design-grid {
      grid-template-columns: 1fr;
      gap: 0.4rem;
    }

    .theme-modal-design {
      padding: 0.45rem;
    }

    .theme-modal-design-preview {
      width: 2.25rem;
      height: 2.25rem;
    }

    .theme-modal-grid {
      grid-template-columns: 1fr 1fr;
      gap: 0.4rem;
    }

    .theme-modal-swatch {
      padding: 0.5rem 0.55rem;
      gap: 0.5rem;
    }

    .theme-modal-color {
      width: 1.5rem;
      height: 1.5rem;
    }

    /* Colorway names are longer in Spanish and Catalan; let them wrap. */
    .theme-modal-name {
      white-space: normal;
    }

    .theme-modal-footer {
      font-size: 0.65rem;
    }
  }
</style>

<script>
  import { pickLang, useTranslations, type Lang } from '../i18n/utils';
  import { getDesignName, getDesignBlurb, getPaletteName } from '../lib/designs';

  // Lightweight wrapper so the modal call sites read `tr(lang, key)` like
  // they did before the refactor; under the hood we lean on the shared
  // `useTranslations(lang)` accessor + a string fallback for missing keys.
  type UiKey = Parameters<ReturnType<typeof useTranslations>>[0];
  const tr = (lang: Lang, key: UiKey): string => useTranslations(lang)(key) || '';

  const initThemeModal = () => {
    const modal = document.getElementById('theme-modal');
    if (!modal || modal.hasAttribute('data-tm-init')) return;
    modal.setAttribute('data-tm-init', 'true');

    const lang = pickLang(document.documentElement.getAttribute('lang'));

    const titleEl = modal.querySelector('[data-i18n-title]');
    const designLabelEl = modal.querySelector('[data-i18n-design]');
    const paletteLabelEl = modal.querySelector('[data-i18n-palette]');
    const footerEl = modal.querySelector('[data-i18n-footer]');
    const panelEl = modal.querySelector('[data-i18n-aria-label]');
    const title = tr(lang, 'theme.customize');
    if (titleEl) titleEl.textContent = title;
    if (designLabelEl) designLabelEl.textContent = tr(lang, 'theme.design');
    if (paletteLabelEl) paletteLabelEl.textContent = tr(lang, 'theme.palette');
    if (footerEl) footerEl.innerHTML = tr(lang, 'theme.closeHint');
    if (panelEl) panelEl.setAttribute('aria-label', title);

    modal.querySelectorAll<HTMLElement>('[data-i18n-design-name]').forEach(el => {
      const id = el.getAttribute('data-i18n-design-name') ?? '';
      const localized = getDesignName(id, lang as Parameters<typeof getDesignName>[1]);
      if (localized) el.textContent = localized;
    });
    modal.querySelectorAll<HTMLElement>('[data-i18n-design-blurb]').forEach(el => {
      const id = el.getAttribute('data-i18n-design-blurb') ?? '';
      const localized = getDesignBlurb(id, lang as Parameters<typeof getDesignBlurb>[1]);
      if (localized) el.textContent = localized;
    });
    modal.querySelectorAll<HTMLElement>('[data-i18n-palette-name]').forEach(el => {
      const id = el.getAttribute('data-i18n-palette-name') ?? '';
      const localized = getPaletteName(id, lang as Parameters<typeof getPaletteName>[1]);
      if (localized) el.textContent = localized;
    });
    modal.querySelectorAll<HTMLElement>('[data-i18n-scheme]').forEach(el => {
      const scheme = el.getAttribute('data-i18n-scheme');
      el.textContent = tr(lang, scheme === 'dark' ? 'theme.dark' : 'theme.light');
    });

    let previouslyFocused: Element | null = null;

    const trapFocus = (e: KeyboardEvent) => {
      if (e.key !== 'Tab') return;
      const focusable = Array.from(
        modal.querySelectorAll<HTMLElement>('button, [tabindex]:not([tabindex="-1"])')
      ).filter(el => !el.closest('[hidden]'));
      if (focusable.length === 0) return;
      const first = focusable[0];
      const last = focusable[focusable.length - 1];
      if (e.shiftKey && document.activeElement === first) {
        e.preventDefault();
        last.focus();
      } else if (!e.shiftKey && document.activeElement === last) {
        e.preventDefault();
        first.focus();
      }
    };

    // A design shows only its own two palettes; the group for the active design
    // is the only one rendered, so a mismatched pairing cannot be picked.
    const refreshActive = () => {
      const currentTheme = document.documentElement.getAttribute('data-theme') || 'dark';
      const currentDesign = document.documentElement.getAttribute('data-design') || 'minimal';
      modal.querySelectorAll<HTMLElement>('.theme-modal-palette-set').forEach(set => {
        set.hidden = set.getAttribute('data-palettes-for') !== currentDesign;
      });
      modal.querySelectorAll<HTMLElement>('.theme-modal-swatch').forEach(s => {
        const on = s.getAttribute('data-theme-id') === currentTheme;
        s.classList.toggle('active', on);
        s.setAttribute('aria-pressed', String(on));
      });
      modal.querySelectorAll<HTMLElement>('.theme-modal-design').forEach(d => {
        const on = d.getAttribute('data-design-id') === currentDesign;
        d.classList.toggle('active', on);
        d.setAttribute('aria-pressed', String(on));
      });
    };

    type DebugApi = { log: (level: string, ns: string, msg: string, ...args: unknown[]) => void };
    const __debug = (): DebugApi | undefined => (window as unknown as { __debug?: DebugApi }).__debug;

    const open = (source: string = 'click') => {
      previouslyFocused = document.activeElement;
      // Ctrl+K is something people do dozens of times; it should not animate.
      modal.classList.toggle('instant', source === 'shortcut');
      modal.classList.add('open');
      modal.setAttribute('aria-hidden', 'false');
      refreshActive();
      // The palette cards lead the panel, so focus there and the panel stays
      // scrolled to the top instead of jumping down to the active design tile.
      const activeEl =
        modal.querySelector('.theme-modal-swatch.active') as HTMLElement ||
        modal.querySelector('.theme-modal-design.active') as HTMLElement;
      if (activeEl) activeEl.focus();
      else (modal.querySelector('.theme-modal-swatch, .theme-modal-design') as HTMLElement)?.focus();
      modal.addEventListener('keydown', trapFocus);
      __debug()?.log('info', 'ui:modal', 'open', { source });
    };

    const close = (source: string = 'click') => {
      modal.classList.remove('open');
      modal.setAttribute('aria-hidden', 'true');
      modal.removeEventListener('keydown', trapFocus);
      if (previouslyFocused instanceof HTMLElement) previouslyFocused.focus();
      __debug()?.log('info', 'ui:modal', 'close', { source });
    };

    modal.querySelector('.theme-modal-backdrop')?.addEventListener('click', () => close('backdrop'));
    modal.querySelector('.theme-modal-close')?.addEventListener('click', () => close('close-button'));

    modal.addEventListener('click', (e) => {
      const target = e.target as HTMLElement;
      const designBtn = target.closest('.theme-modal-design') as HTMLElement | null;
      if (designBtn) {
        const id = designBtn.getAttribute('data-design-id');
        if (!id) return;
        // setDesign loads the design's fonts and snaps the palette to this
        // design's own palette of the same scheme.
        (window as unknown as { setDesign(id: string): void }).setDesign(id);
        refreshActive();
        __debug()?.log('info', 'design', 'select', { id, source: 'modal' });
        return;
      }
      const swatch = target.closest('.theme-modal-swatch') as HTMLElement | null;
      if (swatch) {
        const id = swatch.getAttribute('data-theme-id');
        if (!id) return;
        (window as unknown as { setTheme(id: string): void }).setTheme(id);
        refreshActive();
        __debug()?.log('info', 'theme', 'select', { id, source: 'modal' });
        return;
      }
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'k' && (e.ctrlKey || e.metaKey)) {
        e.preventDefault();
        if (modal.classList.contains('open')) close('shortcut');
        else open('shortcut');
      }
      if (e.key === 'Escape' && modal.classList.contains('open')) {
        close('escape');
      }
    });

    document.addEventListener('open-theme-modal', () => {
      if (!modal.classList.contains('open')) open('event');
    });
  };

  initThemeModal();
  document.addEventListener('astro:page-load', initThemeModal);
</script>

  .theme-modal-design[data-preview-style='zine'] .theme-modal-design-sample {
    font-weight: 900;
    letter-spacing: 0;
    text-transform: uppercase;
    font-family: 'Arial Black', 'Helvetica Neue', sans-serif;
  }

  /* Comic tile: Ben-Day dots + thick outline + rotated chunky sample */
  .theme-modal-design[data-preview-style='comic'] .theme-modal-design-preview {
    background-color: #fff;
    background-image:
      radial-gradient(
        color-mix(in oklab, var(--accent-start) 55%, transparent) 1.2px,
        transparent 1.6px);
    background-size: 6px 6px;
    border: 2px solid #0a0a0a;
    border-radius: 0.4rem;
    box-shadow: 3px 3px 0 #0a0a0a;
  }
  .theme-modal-design[data-preview-style='comic'] .theme-modal-design-sample {
    color: var(--accent-text);
    font-family: Bangers, 'Inter Tight', sans-serif;
    font-weight: 400;
    letter-spacing: 0.05em;
    text-shadow:
      -1.5px 0 0 #0a0a0a,
      1.5px 0 0 #0a0a0a,
      0 -1.5px 0 #0a0a0a,
      0 1.5px 0 #0a0a0a,
      2px 2px 0 #0a0a0a;
    transform: rotate(-3deg);
  }

  /* Newspaper tile: cream paper, double rule, blackletter sample */
  .theme-modal-design[data-preview-style='news'] .theme-modal-design-preview {
    background: color-mix(in oklab, var(--bg-primary) 75%, #f4eedd);
    border: 3px double var(--text-primary);
    border-radius: 0;
    box-shadow: none;
    position: relative;
  }
  .theme-modal-design[data-preview-style='news'] .theme-modal-design-preview::after {
    content: '';
    position: absolute;

---
import {
  THEMES,
  THEME_IDS,
  RETIRED_LIGHT_THEME_IDS,
  DEFAULT_DARK_THEME,
  DEFAULT_LIGHT_THEME,
} from '../lib/themes';
import { DESIGNS, DESIGN_IDS, DEFAULT_DESIGN, getPaletteName } from '../lib/designs';

interface Props {
  position: 'head' | 'body';
}

const { position } = Astro.props;

/**
 * Ownership maps for the head script, which cannot import `lib/palettes.ts`.
 * Every palette belongs to one design, and a design wears only its own.
 */
const PALETTES: Record<string, Record<string, string>> = {}; // design -> { dark, light }
const THEME_DESIGN: Record<string, string> = {}; // palette -> owning design
const THEME_SCHEME: Record<string, string> = {}; // palette -> 'dark' | 'light'
for (const t of THEMES) {
  (PALETTES[t.design] ??= {})[t.colorScheme] = t.id;
  THEME_DESIGN[t.id] = t.design;
  THEME_SCHEME[t.id] = t.colorScheme;
}
// Retired light palettes have no owner but keep their scheme, so a returning
// visitor who stored one lands on the design's day palette, not its night one.
for (const id of RETIRED_LIGHT_THEME_IDS) THEME_SCHEME[id] = 'light';

const pickerDesigns = DESIGNS.filter((d) => !d.hidden);
---

{position === 'head' && (
<script
  is:inline
  define:vars={{
    THEME_IDS,
    DESIGN_IDS,
    DEFAULT_DESIGN,
    DEFAULT_DARK_THEME,
    DEFAULT_LIGHT_THEME,
    PALETTES,
    THEME_DESIGN,
    THEME_SCHEME,
  }}
>
  const VALID_THEMES = THEME_IDS;
  const VALID_DESIGNS = DESIGN_IDS;

  const __systemScheme = () =>
    window.matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark';

  // Every palette belongs to one design, and a design wears only its own.
  // Mirrors resolvePalette() in src/lib/palettes.ts (the head cannot import
  // it); e2e/themes.spec.ts keeps the two in step:
  //  - a palette the design owns is kept;
  //  - another design's palette, or a retired one, becomes this design's
  //    palette of the same scheme, so night never flips to day;
  //  - an id nobody knows follows the system preference.
  const __resolvePalette = (design, id, fallbackScheme) => {
    const own = PALETTES[design];
    if (!own) return fallbackScheme === 'light' ? DEFAULT_LIGHT_THEME : DEFAULT_DARK_THEME;
    if (id && THEME_DESIGN[id] === design) return id;
    return own[(id && THEME_SCHEME[id]) || fallbackScheme];
  };

  const __url = new URL(window.location.href);
  const __themeParam = __url.searchParams.get('theme');
  const __designParam = __url.searchParams.get('design');

  // Design first: the palette is resolved against it.
  let __designSource = 'fallback';
  const __design = (() => {
    if (__designParam && VALID_DESIGNS.includes(__designParam)) {
      localStorage.setItem('design', __designParam);
      __designSource = 'url-param';
      return __designParam;
    }
    // A shared ?theme= link for a palette implies the design that owns it.
    if (__themeParam && THEME_DESIGN[__themeParam]) {
      localStorage.setItem('design', THEME_DESIGN[__themeParam]);
      __designSource = 'url-theme';
      return THEME_DESIGN[__themeParam];
    }
    if (typeof localStorage !== 'undefined') {
      const saved = localStorage.getItem('design');
      if (saved && VALID_DESIGNS.includes(saved)) {
        __designSource = 'localStorage';
        return saved;
      }
    }
    return DEFAULT_DESIGN;
  })();
  document.documentElement.setAttribute('data-design', __design);
  if (window.__debug) window.__debug.log('info', 'design', 'resolved', { design: __design, source: __designSource });

  let __themeSource = 'fallback';
  let __themeFrom = null;
  const __theme = (() => {
    let wanted = null;
    if (__themeParam && THEME_SCHEME[__themeParam]) {
      wanted = __themeParam;
      __themeSource = 'url-param';
    } else if (typeof localStorage !== 'undefined') {
      const saved = localStorage.getItem('theme');
      if (saved && THEME_SCHEME[saved]) {
        wanted = saved;
        __themeSource = 'localStorage';
      }
    }
    const system = __systemScheme();
    if (!wanted) __themeSource = 'system-' + system;
    const resolved = __resolvePalette(__design, wanted, system);
    if (wanted && resolved !== wanted) __themeFrom = wanted;
    // Persist a choice the visitor made (URL) or one we had to correct; a
    // visitor who follows the system keeps following it.
    if (__themeSource === 'url-param' || (__themeSource === 'localStorage' && __themeFrom)) {
      localStorage.setItem('theme', resolved);
    }
    return resolved;
  })();
  document.documentElement.setAttribute('data-theme', __theme);
  if (window.__debug) window.__debug.log('info', 'theme', 'resolved', { theme: __theme, source: __themeSource, snappedFrom: __themeFrom });

  // The params are consumed once: strip them so a reload or share link is clean.
  {
    let dirty = false;
    if (__designSource === 'url-param') { __url.searchParams.delete('design'); dirty = true; }
    if (__themeSource === 'url-param') { __url.searchParams.delete('theme'); dirty = true; }
    if (dirty) history.replaceState(null, '', __url.pathname + __url.search + __url.hash);
  }

  // Load design-specific fonts on demand instead of all 14 families upfront.
  // Core fonts (Inter, Inter Tight, JetBrains Mono) are in the main <link>.
  const __designFonts = {
  editorial:  'family=Playfair+Display:ital,wght@0,700;0,800;1,800;1,900&family=Crimson+Pro:ital,wght@0,400;0,600;1,400',
  pixel:      'family=Press+Start+2P',
  cyber:      'family=Orbitron:wght@500;700;900',
  notebook:   'family=Caveat:wght@500;600;700',
  academic:   'family=EB+Garamond:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500',
  deco:       'family=Poiret+One&family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500&family=Playfair+Display:ital,wght@0,700;0,800;1,800;1,900',
  wabisabi:   'family=Shippori+Mincho:wght@400;500;600;700&family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500',
  comic:      'family=Bangers',
  newspaper:  'family=UnifrakturMaguntia&family=EB+Garamond:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500',
};
  const __loadedFonts = {};
  window.__loadDesignFonts = function(id) {
    if (__loadedFonts[id] || !__designFonts[id]) return;
    __loadedFonts[id] = true;
    const link = document.createElement('link');
    link.rel = 'stylesheet';
    link.href = 'https://fonts.googleapis.com/css2?' + __designFonts[id] + '&display=swap';
    document.head.appendChild(link);
    if (window.__debug) window.__debug.log('info', 'design', 'font-load', { design: id, families: __designFonts[id] });
  };
  window.__loadDesignFonts(__design);

  // Re-render theme when system color scheme flips. Browsers fire this
  // whenever the OS toggles dark/light, so we get a free `theme.info` for
  // free even if no UI is touched.
  try {
    const __scQuery = window.matchMedia('(prefers-color-scheme: dark)');
    if (__scQuery && typeof __scQuery.addEventListener === 'function') {
      __scQuery.addEventListener('change', function(e) {
        if (window.__debug) {
          window.__debug.log('info', 'theme', 'system-changed', { matches: e.matches });
        }
      });
    }
  } catch (_e) {}

  const __apply = (design, theme) => {
    const root = document.documentElement;
    root.setAttribute('data-design', design);
    root.setAttribute('data-theme', theme);
    window.__loadDesignFonts(design);
  };

  // A palette implies its design, so setTheme('comic-day') is always honoured
  // exactly: it switches to Comic if Comic is not already active.
  window.setTheme = function(id) {
    if (!VALID_THEMES.includes(id)) {
      const msg = 'Unknown theme "' + id + '". Available themes:\n' +
      VALID_THEMES.map(function(t) { return '  \u2022 ' + t; }).join('\n');
      console.error(msg);
      if (window.__debug) window.__debug.log('error', 'theme', msg);
      return;
    }
    const design = THEME_DESIGN[id];
    __apply(design, id);
    localStorage.setItem('design', design);
    localStorage.setItem('theme', id);
    if (window.__debug) window.__debug.log('info', 'theme', 'set', { id: id, design: design });
  };

  // Switching design keeps night/day: the palette becomes the new design's own
  // palette of the same scheme.
  window.setDesign = function(id) {
    if (!VALID_DESIGNS.includes(id)) {
      const msg = 'Unknown design "' + id + '". Available designs:\n' +
      VALID_DESIGNS.map(function(d) { return '  \u2022 ' + d; }).join('\n');
      console.error(msg);
      if (window.__debug) window.__debug.log('error', 'theme', msg);
      return;
    }
    const theme = __resolvePalette(id, document.documentElement.getAttribute('data-theme'), __systemScheme());
    __apply(id, theme);
    localStorage.setItem('design', id);
    // Only store the palette for a visitor who has chosen one; a visitor who
    // follows the system keeps following it.
    if (localStorage.getItem('theme') !== null) localStorage.setItem('theme', theme);
    if (window.__debug) window.__debug.log('info', 'design', 'set', { id: id, theme: theme });
  };
</script>
)}

{position === 'body' && (
<div id="theme-modal" class="theme-modal" aria-hidden="true">
  <div class="theme-modal-backdrop"></div>
  <div class="theme-modal-panel" role="dialog" aria-modal="true" data-i18n-aria-label>
    <div class="theme-modal-header">
      <div class="theme-modal-title-group">
        <span class="theme-modal-title" data-i18n-title></span>
        <kbd class="theme-modal-hint">Ctrl+K</kbd>
      </div>
      <button class="theme-modal-close" aria-label="Close" data-i18n-close-aria>
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
    </div>

    <div class="theme-modal-group">
      <span class="theme-modal-label" data-i18n-palette></span>
      {pickerDesigns.map(design => (
        <div class="theme-modal-grid theme-modal-palette-set" data-palettes-for={design.id} hidden>
          {THEMES.filter(theme => theme.design === design.id).map(theme => (
            <button class="theme-modal-swatch" data-kind="theme" data-theme-id={theme.id}>
              <span class="theme-modal-color" style={`--tm-bg: ${theme.preview[0]}; --tm-accent: ${theme.preview[1]}`}></span>
              <span class="theme-modal-swatch-text">
                <span class="theme-modal-name" data-i18n-palette-name={theme.id}>{getPaletteName(theme.id, 'en')}</span>
                <span class="theme-modal-scheme" data-i18n-scheme={theme.colorScheme}></span>
              </span>
            </button>
          ))}
        </div>
      ))}
    </div>

    <div class="theme-modal-divider"></div>

    <div class="theme-modal-group">
      <span class="theme-modal-label" data-i18n-design></span>
      <div class="theme-modal-design-grid">
        {pickerDesigns.map(design => (
          <button
            class="theme-modal-design"
            data-kind="design"
            data-design-id={design.id}
            data-preview-style={design.preview.style}
            style={`--td-font: ${design.preview.font}; --td-radius: ${design.preview.radius};`}
          >
            <span class="theme-modal-design-preview" aria-hidden="true">
              <span class="theme-modal-design-sample">Aa</span>
            </span>
            <span class="theme-modal-design-meta">
              <span class="theme-modal-design-name" data-i18n-design-name={design.id}>{design.label}</span>
              <span class="theme-modal-design-blurb" data-i18n-design-blurb={design.id}>{design.blurb}</span>
            </span>
          </button>
        ))}
      </div>
    </div>

    <div class="theme-modal-footer">
      <span data-i18n-footer></span>
    </div>
  </div>
</div>
)}

<style is:global>
  .theme-modal {
    display: none;
    position: fixed;
    inset: 0;
    z-index: 99999;
    align-items: center;
    justify-content: center;
  }

  .theme-modal.open {
    display: flex;
  }

  .theme-modal-backdrop {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.5);
    backdrop-filter: blur(4px);
    -webkit-backdrop-filter: blur(4px);
    animation: tm-fade-in 150ms var(--ease-out);
  }

  /* Opened from the keyboard: no entrance. */
  .theme-modal.instant .theme-modal-backdrop,
  .theme-modal.instant .theme-modal-panel {
    animation: none;
  }

  @keyframes tm-fade-in {
    from { opacity: 0; }
    to { opacity: 1; }
  }

  .theme-modal-panel {
    position: relative;
    width: min(520px, calc(100% - 2rem));
    max-height: calc(100vh - 2rem);
    overflow-y: auto;
    padding: 1.25rem;
    background: var(--bg-card);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-lg);
    box-shadow: 0 16px 48px rgba(0, 0, 0, 0.4);
    animation: tm-slide-in 180ms var(--ease-out);
  }

  @keyframes tm-slide-in {
    from { opacity: 0; transform: translateY(-8px) scale(0.97); }
    to { opacity: 1; transform: translateY(0) scale(1); }
  }

  .theme-modal-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 1rem;
  }

  .theme-modal-title-group {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .theme-modal-close {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2rem;
    height: 2rem;
    border-radius: var(--radius-sm);
    background: transparent;
    color: var(--text-muted);
    border: none;
    cursor: pointer;
    transition: background-color var(--transition-fast), color var(--transition-fast);
  }

  .theme-modal-close:hover {
    background: var(--bg-secondary);
    color: var(--text-primary);
  }

  .theme-modal-title {
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--text-primary);
  }

  .theme-modal-hint {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    color: var(--text-muted);
    background: var(--bg-secondary);
    padding: 0.15rem 0.4rem;
    border-radius: var(--radius-sm);
    border: 1px solid var(--border-color);
  }

  @media (max-width: 640px) {
    .theme-modal-hint {
      display: none;
    }
  }

  .theme-modal-group + .theme-modal-group {
    margin-top: 0.25rem;
  }

  .theme-modal-label {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.75rem;
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-muted);
    margin-bottom: 0.5rem;
  }

  .theme-modal-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.25rem;
  }

  .theme-modal-design-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.5rem;
  }

  .theme-modal-divider {
    height: 1px;
    background: var(--border-color);
    margin: 0.875rem 0;
  }

  /* A design owns exactly two palettes, so each is a card, like a design tile. */
  .theme-modal-palette-set[hidden] {
    display: none;
  }

  .theme-modal-swatch {
    position: relative;
    display: flex;
    align-items: center;
    gap: 0.65rem;
    padding: 0.55rem 0.6rem;
    border: 1px solid var(--border-color);
    border-radius: var(--radius-sm);
    background: transparent;
    color: var(--text-secondary);
    text-align: left;
    transition: border-color var(--transition-fast), background-color var(--transition-fast), color var(--transition-fast);
  }

  .theme-modal-swatch:hover {
    background: var(--bg-card-hover);
    border-color: var(--border-color-hover);
    color: var(--text-primary);
  }

  .theme-modal-swatch.active {
    border-color: var(--accent-text);
    box-shadow: 0 0 0 1px var(--glow-color);
    color: var(--text-primary);
  }

  .theme-modal-color {
    flex-shrink: 0;
    width: 1.75rem;
    height: 1.75rem;
    border-radius: 50%;
    background: linear-gradient(135deg, var(--tm-bg) 50%, var(--tm-accent) 50%);
    border: 1.5px solid var(--border-color-hover);
  }

  .theme-modal-swatch.active .theme-modal-color {
    border-color: var(--accent-text);
    box-shadow: 0 0 0 2px var(--glow-color);
  }

  .theme-modal-swatch-text {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    min-width: 0;
  }

  .theme-modal-name {
    font-size: 0.8rem;
    font-weight: 600;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .theme-modal-scheme {
    font-size: 0.65rem;
    font-weight: 500;
    letter-spacing: 0.04em;
    color: var(--text-muted);
  }

  /* ── Design swatches ────────────────────────────────────── */
  .theme-modal-design {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    padding: 0.5rem;
    border: 1px solid var(--border-color);
    border-radius: var(--radius-sm);
    background: transparent;
    color: var(--text-secondary);
    text-align: left;
    transition: border-color var(--transition-fast), background-color var(--transition-fast), color var(--transition-fast);
  }

  .theme-modal-design:hover {
    background: var(--bg-card-hover);
    border-color: var(--border-color-hover);
    color: var(--text-primary);
  }

  .theme-modal-design.active {
    border-color: var(--accent-text);
    box-shadow: 0 0 0 1px var(--glow-color);
    color: var(--text-primary);
  }

  .theme-modal-design-preview {
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: var(--td-radius, 0.5rem);
    background: var(--bg-secondary);
    border: 1px solid var(--border-color);
    overflow: hidden;
    position: relative;
  }

  .theme-modal-design-sample {
    font-family: var(--td-font, inherit);
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--text-primary);
    line-height: 1;
  }

  .theme-modal-design[data-preview-style='gradient'] .theme-modal-design-preview {
    background: linear-gradient(135deg, var(--bg-secondary) 0%, var(--bg-secondary) 55%, color-mix(in oklab, var(--accent-start) 35%, var(--bg-secondary)) 100%);
  }
  .theme-modal-design[data-preview-style='gradient'] .theme-modal-design-preview::after {
    content: '';
    position: absolute;
    top: 0; left: 0; right: 0;
    height: 3px;
    background: linear-gradient(90deg, var(--accent-start), var(--accent-end));
  }

  .theme-modal-design[data-preview-style='serif'] .theme-modal-design-sample {
    font-style: italic;
  }
  .theme-modal-design[data-preview-style='serif'] .theme-modal-design-preview {
    border-radius: 0;
    border-bottom: 2px solid var(--text-primary);
  }

  .theme-modal-design[data-preview-style='grid'] .theme-modal-design-preview {
    border-radius: 0;
    border: 1px solid var(--text-primary);
  }
  .theme-modal-design[data-preview-style='grid'] .theme-modal-design-preview::before {
    content: '02';
    position: absolute;
    top: 2px; right: 4px;
    font-size: 0.55rem;
    font-weight: 800;
    color: #e10600;
    line-height: 1;
    font-variant-numeric: tabular-nums;
  }

  .theme-modal-design[data-preview-style='pixel'] .theme-modal-design-preview {
    border-radius: 0;
    border: 2px solid var(--text-primary);
    box-shadow: 2px 2px 0 var(--text-primary);
    background: var(--bg-secondary);
  }
  .theme-modal-design[data-preview-style='pixel'] .theme-modal-design-sample {
    font-size: 0.65rem;
  }

  .theme-modal-design[data-preview-style='terminal'] .theme-modal-design-preview {
    border-radius: 0;
    border: 1px dashed var(--accent-start);
    background: var(--bg-secondary);
    background-image: repeating-linear-gradient(
      to bottom,
      transparent 0,
      transparent 2px,
      rgba(0, 0, 0, 0.12) 2px,
      rgba(0, 0, 0, 0.12) 3px
    );
  }
  .theme-modal-design[data-preview-style='terminal'] .theme-modal-design-sample {
    font-size: 0.8rem;
    color: var(--accent-text);
  }
  .theme-modal-design[data-preview-style='terminal'] .theme-modal-design-sample::before {
    content: '>';
    margin-right: 2px;
    opacity: 0.7;
  }

  .theme-modal-design[data-preview-style='neon'] .theme-modal-design-preview {
    border-radius: 0;
    border: 1px solid var(--accent-start);
    background:
      linear-gradient(transparent 0, transparent 60%, color-mix(in oklab, var(--accent-start) 35%, transparent) 100%),
      var(--bg-secondary);
    box-shadow: 0 0 10px color-mix(in oklab, var(--accent-start) 40%, transparent),
      inset 0 0 8px color-mix(in oklab, var(--accent-start) 15%, transparent);
  }
  .theme-modal-design[data-preview-style='neon'] .theme-modal-design-sample {
    text-shadow: -1px 0 0 #ff2e88, 1px 0 0 #00f0ff;
    font-weight: 800;
    letter-spacing: 0.04em;
  }

  .theme-modal-design[data-preview-style='paper'] .theme-modal-design-preview {
    background-color: var(--bg-secondary);
    background-image:
      linear-gradient(to right, color-mix(in oklab, var(--text-primary) 12%, transparent) 1px, transparent 1px),
      linear-gradient(to bottom, color-mix(in oklab, var(--text-primary) 12%, transparent) 1px, transparent 1px);
    background-size: 8px 8px;
    border: 1px solid color-mix(in oklab, var(--text-primary) 35%, transparent);
    border-radius: 0.4rem;
    transform: rotate(-2deg);
    box-shadow: 2px 3px 0 color-mix(in oklab, var(--text-primary) 20%, transparent);
  }
  .theme-modal-design[data-preview-style='paper'] .theme-modal-design-sample {
    transform: rotate(2deg);
    position: relative;
  }
  .theme-modal-design[data-preview-style='paper'] .theme-modal-design-sample::after {
    content: '';
    position: absolute;
    left: -2px;
    right: -2px;
    bottom: 2px;
    height: 5px;
    background: color-mix(in oklab, var(--accent-start) 40%, #fff58a);
    opacity: 0.6;
    z-index: -1;
    border-radius: 1px;
  }

  .theme-modal-design[data-preview-style='raw'] .theme-modal-design-preview {
    background: #ffe000;
    border: 3px solid var(--text-primary);
    border-radius: 0;
    box-shadow: 3px 3px 0 var(--text-primary);
  }
  .theme-modal-design[data-preview-style='raw'] .theme-modal-design-sample {
    font-weight: 900;
    font-style: italic;
    color: #000;
  }


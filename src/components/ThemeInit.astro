    letter-spacing: 0.02em;
    color: var(--text-primary);
  }

  .theme-modal-design-meta {
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
    min-width: 0;
  }

  .theme-modal-design-name {
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--text-primary);

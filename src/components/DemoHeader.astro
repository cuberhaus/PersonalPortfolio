---
interface Props {
  badge: string;
  title: string;
  lead: string;
  githubUrl?: string | string[];
  githubLabel: string | string[];
  /**
   * Brand accent gradient for the header. Prefer passing `demo.accent` from
   * `getDemo()` so the colors stay co-located with the demo metadata in
   * `src/data/demos.json`. Falls back to the global accent variables when
   * neither this nor the legacy `accentFrom`/`accentTo` props are provided.
   */
  accent?: { from: string; to: string };
  /** @deprecated Pass `accent={{ from, to }}` instead — kept for back-compat. */
  accentFrom?: string;
  /** @deprecated Pass `accent={{ from, to }}` instead — kept for back-compat. */
  accentTo?: string;
}

const { badge, title, lead, githubUrl, githubLabel, accent, accentFrom, accentTo } = Astro.props;

const fromColor = accent?.from ?? accentFrom ?? 'var(--accent-start)';
const toColor = accent?.to ?? accentTo ?? 'var(--accent-end)';

const urls =
  githubUrl === undefined
    ? []
    : Array.isArray(githubUrl)
      ? githubUrl.filter((u): u is string => typeof u === 'string' && u.length > 0)
      : [githubUrl];
const labels = Array.isArray(githubLabel) ? githubLabel : [githubLabel];
---

<header class="demo-header" style={`--hdr-from: ${fromColor}; --hdr-to: ${toColor};`}>
  <div class="demo-header-copy">
    <div class="demo-hdr-badge">{badge}</div>
    <h1 class="demo-hdr-title">{title}</h1>
    <p class="demo-hdr-lead" set:html={lead} />
    <slot />
  </div>
  {
    urls.length > 0 && (
      <div class="demo-header-actions">
        {urls.map((url, i) => (
          <a
            href={url}
            class="demo-header-github"
            target="_blank"
            rel="noopener noreferrer"
            aria-label={labels[i] ?? labels[0]}
          >
            <svg
              width="18"
              height="18"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4" />
              <path d="M9 18c-4.51 2-5-2-7-2" />
            </svg>
            {labels[i] ?? labels[0]}
          </a>
        ))}
      </div>
    )
  }
</header>

<style>
  .demo-header {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 2rem;
    align-items: end;
    text-align: left;
    margin: 1.5rem 0 3rem;
    padding: 2.25rem 0 2rem 1.5rem;
    border-top: 1px solid var(--text-primary);
    border-bottom: 1px solid var(--border-color);
  }

  .demo-header::before {
    content: '';
    position: absolute;
    top: -1px;
    bottom: -1px;
    left: 0;
    width: 0.4rem;
    background: var(--hdr-from);
  }

  .demo-header-copy {
    min-width: 0;
  }

  .demo-hdr-badge {
    display: block;
    width: fit-content;
    margin-bottom: 0.8rem;
    color: var(--text-secondary);
    font-size: 0.82rem;
    font-weight: 600;
    line-height: 1.3;
  }

  .demo-hdr-title {
    max-width: 17ch;
    margin: 0 0 1rem;
    color: var(--text-primary);
    font-size: clamp(2.75rem, 6vw, 4rem);
    font-weight: 800;
    letter-spacing: -0.03em;
    line-height: 0.98;
  }

  .demo-hdr-lead {
    color: var(--text-secondary);
    max-width: 65ch;
    margin: 0;
    line-height: 1.6;
    font-size: 1.05rem;
  }

  .demo-header-actions {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    align-items: stretch;
  }

  .demo-header-github {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.55rem;
    min-height: 2.75rem;
    padding: 0.6rem 0.9rem;
    border: 1px solid var(--text-primary);
    border-radius: 0;
    color: var(--text-primary);
    background: transparent;
    font-size: 0.82rem;
    font-weight: 650;
    line-height: 1.2;
    transition:
      color var(--transition-fast),
      background-color var(--transition-fast);
  }

  .demo-header-github:hover {
    color: var(--bg-primary);
    background: var(--text-primary);
  }

  .demo-header-github:focus-visible {
    outline: 2px solid var(--hdr-from);
    outline-offset: 3px;
  }

  .demo-hdr-lead :global(strong) {
    color: var(--text-primary, #e4e4e7);
  }

  /* Inline links in lead copy must be visually distinguishable from
     surrounding text to satisfy WCAG SC 1.4.1. Use --text-primary for
     contrast with --text-secondary, plus an underline. */
  .demo-hdr-lead :global(a) {
    color: var(--text-primary);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 2px;
  }

  .demo-hdr-lead :global(a:hover),
  .demo-hdr-lead :global(a:focus-visible) {
    color: var(--accent-text);
  }

  @media (max-width: 700px) {
    .demo-header {
      grid-template-columns: 1fr;
      gap: 1.5rem;
      margin: 1rem 0 2rem;
      padding: 1.5rem 0 1.5rem 1rem;
    }

    .demo-hdr-title {
      font-size: clamp(2.35rem, 12vw, 3.25rem);
    }

    .demo-hdr-lead {
      font-size: 0.95rem;
    }

    .demo-header-actions {
      align-items: flex-start;
    }
  }
</style>

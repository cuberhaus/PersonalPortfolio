---
/**
 * Localized demo router.
 *
 * Adding a new demo? Drop a new file at `src/pages/demos/<slug>.astro` and
 * the corresponding entry in `src/data/demos.json` (+ .es.json / .ca.json).
 * The eager page glob picks the page up automatically — no edits needed here.
 */
import { LOCALES } from '../../../config/locales';
import ErrorPage from '../../../components/ErrorPage.astro';
import Layout from '../../../layouts/Layout.astro';
import { getLangFromUrl, useTranslations } from '../../../i18n/utils';
import { createDemoModuleLookup, listDemoSlugs } from '../../../lib/demo-dispatch';
import { loadDemoModules } from '../../../lib/demo-modules';

type DemoComponent = typeof import('../../demos/algorithms.astro').default;

const demosBySlug = createDemoModuleLookup(loadDemoModules<DemoComponent>());

export function getStaticPaths() {
  const slugs = listDemoSlugs(loadDemoModules<DemoComponent>());
  // Default locale is served from /demos/<slug>; this dynamic route only
  // exists for the prefixed locales (es, ca, …).
  const langs = LOCALES.filter((l) => l !== LOCALES[0]);
  return langs.flatMap((lang) => slugs.map((demo) => ({ params: { lang, demo } })));
}

const { demo } = Astro.params;
const Component = demo ? demosBySlug[demo] : undefined;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const base = import.meta.env.BASE_URL === '/' ? '' : import.meta.env.BASE_URL;

if (!Component) Astro.response.status = 404;
---

{
  Component ? (
    <Component />
  ) : (
    <Layout title={`404 — ${t('notFound.title')}`} description={t('notFound.message')}>
      <ErrorPage
        code={404}
        title={t('notFound.title')}
        message={t('notFound.message')}
        backLabel={t('notFound.back')}
        backHref={base || '/'}
      />
    </Layout>
  )
}

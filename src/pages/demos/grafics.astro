---
import DemoLayout from '../../layouts/DemoLayout.astro';
import DemoHeader from '../../components/DemoHeader.astro';
import GraficsDemo from '../../components/demos/GraficsDemo';
import LiveAppEmbed from '../../components/demos/LiveAppEmbed';
import LiveAppFallbackRegion from '../../components/demos/LiveAppFallbackRegion.astro';
import { getDemoPageContext } from '../../lib/demo-page';

const { lang, t, demo } = getDemoPageContext(Astro.url, 'grafics');
---

<DemoLayout
  title={demo.title}
  description={demo.metaDescription}
  slug="grafics"
  ogImage="/og/grafics-og.png"
>
  <div class="container">
    <DemoHeader
      badge={demo.badge}
      title={demo.title}
      lead={demo.lead}
      githubUrl={demo.github}
      githubLabel={t('demo.viewSource')}
      accent={demo.accent}
    />

    <LiveAppFallbackRegion>
      <LiveAppEmbed
        slot="embed"
        slug="grafics"
        title="Gràfics Shader Playground"
        lang={lang}
        client:load
      />

      <div slot="fallback" id="grafics-mock-fallback">
        <GraficsDemo lang={lang} client:visible />
      </div>
    </LiveAppFallbackRegion>
  </div>
</DemoLayout>

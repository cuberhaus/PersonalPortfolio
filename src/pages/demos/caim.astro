---
import DemoLayout from '../../layouts/DemoLayout.astro';
import DemoHeader from '../../components/DemoHeader.astro';
import CAIMDemo from '../../components/demos/CAIMDemo';
import LiveAppEmbed from '../../components/demos/LiveAppEmbed';
import { getDemoPageContext } from '../../lib/demo-page';

const { lang, t, demo } = getDemoPageContext(Astro.url, 'caim');
---

<DemoLayout
  title={demo.title}
  description={demo.metaDescription}
  slug="caim"
  ogImage="/og/caim-og.png"
>
  <div class="container">
    <DemoHeader
      badge={demo.badge}
      title={demo.title}
      lead={demo.lead}
      githubUrl={demo.github}
      githubLabel={t('demo.viewSource')}
      accent={demo.accent}
    />

    <LiveAppEmbed
      slug="caim"
      title="CAIM IR Explorer"
      lang={lang}
      fallbackSelector=".caim-mock"
      client:load
    />

    <CAIMDemo lang={lang} client:visible />

    <div class="demo-info">
      <h3>{demo.aboutTitle}</h3>
      <p>{demo.aboutDescription}</p>
    </div>
  </div>
</DemoLayout>

<style>
  .demo-info {
    margin-top: 2.5rem;
    padding: 2rem;
    background: var(--bg-card);
    border-radius: var(--radius-lg);
    border: 1px solid var(--border-color);
    max-width: 720px;
    margin-left: auto;
    margin-right: auto;
  }

  .demo-info h3 {
    margin-bottom: 0.75rem;
  }

  .demo-info p {
    color: var(--text-muted);
    line-height: 1.7;
    margin-bottom: 1.25rem;
  }
</style>

---
import DemoLayout from '../../layouts/DemoLayout.astro';
import DemoHeader from '../../components/DemoHeader.astro';
import ParDemo from '../../components/demos/ParDemo';
import LiveAppEmbed from '../../components/demos/LiveAppEmbed';
import { getDemoPageContext } from '../../lib/demo-page';

const { lang, t, demo } = getDemoPageContext(Astro.url, 'par-parallel');
---

<DemoLayout
  title={demo.title}
  description={demo.metaDescription}
  slug="par-parallel"
  ogImage="/og/par-parallel-og.png"
>
  <div class="container">
    <DemoHeader
      badge={demo.badge}
      title={demo.title}
      lead={demo.lead}
      githubUrl={demo.github}
      githubLabel={t('demo.viewSource')}
      accent={demo.accent}
    />

    <LiveAppEmbed
      slug="par-parallel"
      title="PAR Parallel Computing"
      lang={lang}
      fallbackSelector="#par-mock-fallback"
      client:load
    />

    <div id="par-mock-fallback">
      <ParDemo lang={lang} client:visible />
    </div>
  </div>
</DemoLayout>

---
import DemoLayout from '../../layouts/DemoLayout.astro';
import DemoHeader from '../../components/DemoHeader.astro';
import ApaPracticaDemo from '../../components/demos/ApaPracticaDemo';
import { getDemoPageContext } from '../../lib/demo-page';

const { lang, t, demo } = getDemoPageContext(Astro.url, 'apa-practica');
---

<DemoLayout
  title={demo.metaTitle ?? demo.title}
  description={demo.metaDescription}
  slug="apa-practica"
  ogImage="/og/apa-practica-og.png"
>
  <div class="container">
    <DemoHeader
      badge={demo.badge}
      title={demo.title}
      lead={demo.lead}
      githubUrl={demo.github}
      githubLabel={t('demo.viewSource')}
      accent={demo.accent}
    />

    <ApaPracticaDemo lang={lang} client:visible />
  </div>
</DemoLayout>

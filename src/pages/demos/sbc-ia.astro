---
import DemoLayout from '../../layouts/DemoLayout.astro';
import DemoHeader from '../../components/DemoHeader.astro';
import LiveAppEmbed from '../../components/demos/LiveAppEmbed';
import LiveAppFallbackRegion from '../../components/demos/LiveAppFallbackRegion.astro';
import SbcDemo from '../../components/demos/SbcDemo';
import { getDemoPageContext } from '../../lib/demo-page';

const { lang, t, demo } = getDemoPageContext(Astro.url, 'sbc-ia');
---

<DemoLayout
  title={demo.title}
  description={demo.metaDescription}
  slug="sbc-ia"
  ogImage="/og/sbc-ia-og.png"
>
  <div class="container">
    <DemoHeader
      badge={demo.badge}
      title={demo.title}
      lead={demo.lead}
      githubUrl={demo.github}
      githubLabel={t('demo.viewSource')}
      accent={demo.accent}
    />

    <LiveAppFallbackRegion>
      <LiveAppEmbed
        slot="embed"
        slug="sbc-ia"
        title="SBC_IA Trip Planner"
        lang={lang}
        client:load
      />

      <div slot="fallback" id="sbc-mock-fallback" class="sbc-demo-wrapper">
        <SbcDemo lang={lang} client:visible />
      </div>
    </LiveAppFallbackRegion>
  </div>
</DemoLayout>

<style>
  .sbc-demo-wrapper {
    border-radius: var(--radius-lg);
    border: 1px solid var(--border-color);
    overflow: hidden;
    background: var(--bg-card);
    padding: 1.5rem;
    min-height: 400px;
  }
</style>

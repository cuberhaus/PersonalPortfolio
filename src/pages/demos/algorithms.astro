---
import DemoLayout from '../../layouts/DemoLayout.astro';
import DemoHeader from '../../components/DemoHeader.astro';
import FibDemo from '../../components/demos/FibDemo';
import LiveAppEmbed from '../../components/demos/LiveAppEmbed';
import LiveAppFallbackRegion from '../../components/demos/LiveAppFallbackRegion.astro';
import { getDemoPageContext } from '../../lib/demo-page';

const { lang, t, demo } = getDemoPageContext(Astro.url, 'algorithms');
---

<DemoLayout
  title={demo.title}
  description={demo.metaDescription}
  slug="algorithms"
  ogImage="/og/algorithms-og.png"
>
  <div class="container">
    <DemoHeader
      badge={demo.badge}
      title={demo.title}
      lead={demo.lead}
      githubUrl={demo.github}
      githubLabel={t('demo.viewSource')}
      accent={demo.accent}
    />

    <LiveAppFallbackRegion>
      <LiveAppEmbed
        slot="embed"
        slug="algorithms"
        title="Algorithm Visualizer"
        lang={lang}
        client:load
      />

      <div slot="fallback" id="fib-mock-fallback">
        <FibDemo lang={lang} client:visible />
      </div>
    </LiveAppFallbackRegion>
  </div>
</DemoLayout>

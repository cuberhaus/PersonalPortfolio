---
import DemoLayout from '../../layouts/DemoLayout.astro';
import DemoHeader from '../../components/DemoHeader.astro';
import DesastresIADemo from '../../components/demos/DesastresIADemo';
import LiveAppEmbed from '../../components/demos/LiveAppEmbed';
import { getDemoPageContext } from '../../lib/demo-page';

const { lang, t, demo } = getDemoPageContext(Astro.url, 'desastres-ia');
---

<DemoLayout
  title={demo.title}
  description={demo.metaDescription}
  slug="desastres-ia"
  ogImage="/og/desastres-ia-og.png"
>
  <div class="container">
    <DemoHeader
      badge={demo.badge}
      title={demo.title}
      lead={demo.lead}
      githubUrl={demo.github}
      githubLabel={t('demo.viewSource')}
      accent={demo.accent}
    />

    <LiveAppEmbed slug="desastres-ia" title="DesastresIA Solver" lang={lang} client:load />

    <DesastresIADemo lang={lang} client:visible />
  </div>
</DemoLayout>

---
import Layout from '../layouts/Layout.astro';
import ErrorPage from '../components/ErrorPage.astro';
import { useTranslations } from '../i18n/utils';
import { DEFAULT_LOCALE } from '../config/locales';

// 404 is a static page so it ships the default-locale copy at build time;
// the inline script below upgrades the strings to the visitor's locale
// (derived from the URL prefix) using the same `ui` dictionary as the rest
// of the site.
const t = useTranslations(DEFAULT_LOCALE);
---

<Layout title={`404 — ${t('notFound.title')}`} description={t('notFound.message')}>
  <ErrorPage
    code={404}
    title={t('notFound.title')}
    message={t('notFound.message')}
    backLabel={t('notFound.back')}
    backHref={import.meta.env.BASE_URL === '/' ? '/' : import.meta.env.BASE_URL}
  />
</Layout>

<script>
  import { ui } from '../i18n/ui';
  import { pickLang } from '../i18n/utils';
  import { PREFIXED_LOCALES } from '../config/locales';

  // Pull the locale prefix out of the URL (e.g. `/es/foo` → `'es'`); fall
  // back to the default locale's already-server-rendered copy when the URL
  // has no recognised prefix.
  const segments = window.location.pathname.replace(/^\/+/, '').split('/');
  const detected = PREFIXED_LOCALES.find((l) => segments.includes(l));
  if (detected) {
    const lang = pickLang(detected);
    const bundle = ui[lang];
    const title = document.getElementById('error-title');
    const msg = document.getElementById('error-message');
    const back = document.getElementById('back-label');
    if (title) title.textContent = bundle['notFound.title'];
    if (msg) msg.textContent = bundle['notFound.message'];
    if (back) back.textContent = bundle['notFound.back'];
  }
</script>
